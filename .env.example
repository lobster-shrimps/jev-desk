# ---- judge machine (the ONLY place the TypeSafe key lives) ----
TYPESAFE_API_KEY=ts-...
DESK_SECRET=            # openssl rand -hex 24 ; shared with the bots, never the key
                        # SECURITY: Never print, log, or commit this value. Rotates by restarting judge + shift.
# JUDGE_MOCK=1          # run the judge without a key (synthetic answers, testing only)
                        # NEVER trade against JUDGE_MOCK=1 - answers are deterministic noise.

# ---- shift machine (run.py) ----
JUDGE_URL=https://<your-cloudflared-host>/judge
DESK_SECRET=            # same value as above
BANK_USD=1000           # free cash. SIZE clamps tickets at 6% of this.
# FOMO_BEARER=          # optional: paste the Privy token instead of reading it from Chrome
# CDP_URL=http://127.0.0.1:9222
# SOCIAL_URL=           # SOCIAL bot endpoint: POST {"x_handle"} -> the X block
#                       # Unset: in-desk fxtwitter lookup (no key). Failure = NO_SOCIAL_CUT.
# X_LOOKUPS_PER_CYCLE=15  # cap fxtwitter HTTP lookups per cycle (judge step only)
# SEATS_WEBHOOK_URL=    # CHIEF's inbox. Unset: orders land in outbox/orders/
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DESK_DB=desk.db
# CONFIRM_LIVE=yes      # REQUIRED for --live mode. Shadow-only without this gate.
                        # SAFETY: Run shadow for a week before setting this. Only real fills count.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com  # Solana RPC endpoint for top wallet checks
# GT_INFO_CACHE_TTL_MIN=90  # cache GT /tokens/{addr}/info in outbox/ (clamped 60-120)
# COINALYZE_API_KEY=        # optional. Log-only market regime on /ops + briefing. Missing = skip.
